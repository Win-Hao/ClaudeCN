{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ClaudeCN 主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://claude.ai/*" },
        { "url": "https://github.com/*" }
      ]
    }
  ]
}
